# ============================================================
# BioSketch3D .gitignore
# React/Vite frontend + FastAPI backend + classifier + FFD pipeline
# ============================================================

# ----------------------------
# OS / editor files
# ----------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*.tmp
*.temp
*.log

.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
model_scripts/.vscode/
backend/deform/.vscode/

# ----------------------------
# Environment files / secrets
# ----------------------------
.env
.env.*
!.env.example

frontend/.env
frontend/.env.*
!frontend/.env.example

backend/.env
backend/.env.*
!backend/.env.example

# ----------------------------
# Python caches / build files
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.cache/

build/
dist/
*.egg-info/
.eggs/

# ----------------------------
# Python virtual environments
# ----------------------------
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/
model_scripts/.venv/
model_scripts/venv/
brain_env/

# ----------------------------
# Jupyter
# ----------------------------
.ipynb_checkpoints/

# ----------------------------
# Node / React / Vite frontend
# ----------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.eslintcache

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Keep frontend dependency files committed
!frontend/package.json
!frontend/package-lock.json

# ----------------------------
# Backend runtime uploads / outputs
# ----------------------------
backend/uploads/
backend/outputs/
backend/tmp/
backend/temp/
backend/debug_results/

# Keep empty runtime folders in Git when .gitkeep files are present
!backend/uploads/.gitkeep
!backend/outputs/.gitkeep

# ----------------------------
# Deformation runtime / presentation debug files
# ----------------------------
backend/deform/presentation_debug/*

# Keep optional placeholders/docs
!backend/deform/presentation_debug/.gitkeep
!backend/deform/presentation_debug/README.md

# ----------------------------
# Training datasets and experiment artifacts
# ----------------------------
dataset/
datasets/
data/raw/
data/processed/

model_scripts/data/raw/
model_scripts/data/processed/
model_scripts/reports/
model_scripts/runs/
model_scripts/wandb/

reports/
experiments/
outputs/

# ----------------------------
# ML checkpoint files
# ----------------------------
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.pkl
*.joblib

# The trained classifier checkpoint is required at runtime.
# Keep this exception only when the file is small enough for GitHub
# or when Git LFS is configured.
!model_scripts/checkpoints/organ_classifier/best_model.pt

# Optional placeholders/docs
!model_scripts/checkpoints/.gitkeep
!model_scripts/checkpoints/organ_classifier/.gitkeep
!model_scripts/checkpoints/organ_classifier/README.md

# ----------------------------
# 3D model assets
# ----------------------------
*.glb
*.gltf
*.obj
*.fbx
*.stl
*.ply
*.blend

# These validated baseline GLB files are required by the deformation pipeline.
# Keep the exceptions if the files are small enough for GitHub
# or when Git LFS is configured.
!backend/deform/assets/3d_models/brain.glb
!backend/deform/assets/3d_models/heart.glb
!backend/deform/assets/3d_models/lungs.glb

# Optional placeholders/docs
!backend/deform/assets/.gitkeep
!backend/deform/assets/3d_models/.gitkeep
!backend/deform/assets/3d_models/README.md
!frontend/public/models/.gitkeep
!frontend/public/models/README.md

# ----------------------------
# Generated media
# ----------------------------
*.mp4
*.mov
*.avi
*.mkv

# ----------------------------
# Executables / installers
# ----------------------------
*.exe
*.msi
*.dmg
*.pkg
